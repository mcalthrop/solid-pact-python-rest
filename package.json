{
  "name": "solid-pact-python-rest",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": "24.14.0",
    "pnpm": ">=10.18.1",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "pact:broker:up": "docker compose up --detach",
    "pact:broker:down": "docker compose down",
    "pact:consumer-test": "pnpm --filter web pact:consumer-test",
    "pact:consumer-publish": "pnpm --filter web pact:consumer-publish",
    "pact:provider-verify": "pnpm --filter api pact:provider-verify",
    "pact:verify": "bash scripts/pact-verify.sh",
    "openapi:generate": "turbo run openapi:generate",
    "openapi:validate": "turbo run openapi:validate",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "knip": "turbo run knip"
  },
  "devDependencies": {
    "turbo": "2.5.4"
  }
}
